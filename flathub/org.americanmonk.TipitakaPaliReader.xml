<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.americanmonk.TipitakaPaliReader</id>
  
  <name>Tipitaka Pali Reader</name>
  <summary>Study Pāḷi texts with ease</summary>
  
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer_name>org.americanmonk</developer_name>

  <description>
    <p>
      Tipitaka Pali Reader (TPR) is designed for reading and studying Pāḷi texts. 
      It offers integrated dictionary support, multi-language definitions, and 
      support for various scripts. Ideal for students of early Buddhist texts, it 
      enables fast lookup of word meanings and root structures.

      May all beings benefit from this dhamma donation!
    </p>
  </description>

  <releases>
    <release version="2.9.3+123" date="2026-09-04">
      <description>
        <p>
          TPR build 123 released. Critical index bug is fixed.  jumping and highlight bug is fixed.
        </p>
      </description>
    </release>
  </releases>

